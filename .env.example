# PostgreSQL 16 (local)
DATABASE_URL="postgresql://username:password@localhost:5432/todolist?schema=public"

# SQLite source for one-time data migration (defaults to prisma/dev.db)
# SQLITE_DATABASE_URL="file:./prisma/dev.db"

# SQLite (legacy dev default)
# DATABASE_URL="file:./prisma/dev.db"

# Optional: OpenAI API key for grammar check in task details
# OPENAI_API_KEY=""

# Optional: max backup ZIP upload size for restore (bytes, default 157286400 = 150 MB)
# BACKUP_MAX_UPLOAD_BYTES="157286400"

# --- Multi-user auth (Better Auth) ---

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Comma-separated list of allowed origins for auth + CORS (web origin, plus
# any Capacitor scheme such as capacitor://localhost). You can use either
# variable; both are merged in lib/trusted-origins.ts.
AUTH_TRUSTED_ORIGINS="http://localhost:3000"
# BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000"

# Google Cloud Console > OAuth client (Web application).
# Authorized redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email of the account that should receive pre-existing single-tenant data.
# This variable is ONLY read by `npm run claim:legacy-data` — it does not move
# data when you sign in. Sign in with Google using this exact email once first,
# THEN run:
#   npm run diagnose:legacy-data            (see legacy row counts)
#   npm run claim:legacy-data -- --dry-run   (preview, no changes)
#   npm run claim:legacy-data                (apply)
# See docs/DEPLOY.md "Claiming legacy data" for the full runbook.
LEGACY_OWNER_EMAIL=""
