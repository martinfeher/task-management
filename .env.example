# PostgreSQL 16 (local)
DATABASE_URL="postgresql://username:password@localhost:5432/todolist?schema=public"

# SQLite source for one-time data migration (defaults to prisma/dev.db)
# SQLITE_DATABASE_URL="file:./prisma/dev.db"

# SQLite (legacy dev default)
# DATABASE_URL="file:./prisma/dev.db"

# Optional: OpenAI API key for grammar check in task details
# OPENAI_API_KEY=""

# Optional: max backup ZIP upload size for restore (bytes, default 157286400 = 150 MB)
# BACKUP_MAX_UPLOAD_BYTES="157286400"
